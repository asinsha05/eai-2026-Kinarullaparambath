<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             id="defs" targetNamespace="https://eai-2026/capstone">
  <message id="msgAccepted" name="order.accepted"/>
  <error id="errDownstream" name="downstream failure" errorCode="downstream_error"/>
  <process id="checkout_saga" name="Checkout saga" isExecutable="false">
    <startEvent id="start" name="order.accepted received">
      <messageEventDefinition messageRef="msgAccepted"/>
    </startEvent>
    <exclusiveGateway id="gw_type" name="orderType is b2b?"/>
    <task id="t_payment" name="payment authorize"/>
    <task id="t_inventory" name="inventory reserve"/>
    <task id="t_shipping" name="shipping create"/>
    <task id="t_notification" name="notification send"/>
    <task id="t_refund" name="payment_refund" isForCompensation="true"/>
    <task id="t_release" name="inventory_release" isForCompensation="true"/>
    <boundaryEvent id="b_pay_err" name="payment 4xx" attachedToRef="t_payment">
      <errorEventDefinition errorRef="errDownstream"/>
    </boundaryEvent>
    <boundaryEvent id="b_pay_comp" attachedToRef="t_payment">
      <compensateEventDefinition/>
    </boundaryEvent>
    <boundaryEvent id="b_inv_err" name="inventory error" attachedToRef="t_inventory">
      <errorEventDefinition errorRef="errDownstream"/>
    </boundaryEvent>
    <boundaryEvent id="b_inv_comp" attachedToRef="t_inventory">
      <compensateEventDefinition/>
    </boundaryEvent>
    <boundaryEvent id="b_ship_err" name="shipping error" attachedToRef="t_shipping">
      <errorEventDefinition errorRef="errDownstream"/>
    </boundaryEvent>
    <boundaryEvent id="b_ship_timer" name="timeout 2.5 s" attachedToRef="t_shipping">
      <timerEventDefinition><timeDuration xsi:type="tFormalExpression">PT2.5S</timeDuration></timerEventDefinition>
    </boundaryEvent>
    <boundaryEvent id="b_notif_err" name="notification error" attachedToRef="t_notification">
      <errorEventDefinition errorRef="errDownstream"/>
    </boundaryEvent>
    <intermediateThrowEvent id="throw_comp" name="compensate completed steps in reverse">
      <compensateEventDefinition/>
    </intermediateThrowEvent>
    <endEvent id="end_completed" name="completed"/>
    <endEvent id="end_failed" name="failed"/>
    <endEvent id="end_compensated" name="compensated"/>
    <association id="as1" associationDirection="One" sourceRef="b_pay_comp" targetRef="t_refund"/>
    <association id="as2" associationDirection="One" sourceRef="b_inv_comp" targetRef="t_release"/>
    <sequenceFlow id="f1" sourceRef="start" targetRef="gw_type"/>
    <sequenceFlow id="f2" sourceRef="gw_type" targetRef="t_payment">
      <conditionExpression xsi:type="tFormalExpression">orderType != 'b2b'</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="f3" sourceRef="gw_type" targetRef="t_inventory">
      <conditionExpression xsi:type="tFormalExpression">orderType == 'b2b'</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="f4" sourceRef="t_payment" targetRef="t_inventory"/>
    <sequenceFlow id="f5" sourceRef="t_inventory" targetRef="t_shipping"/>
    <sequenceFlow id="f6" sourceRef="t_shipping" targetRef="t_notification"/>
    <sequenceFlow id="f7" sourceRef="t_notification" targetRef="end_completed"/>
    <sequenceFlow id="f8" sourceRef="b_pay_err" targetRef="end_failed"/>
    <sequenceFlow id="f9" sourceRef="b_inv_err" targetRef="throw_comp"/>
    <sequenceFlow id="f10" sourceRef="b_ship_err" targetRef="throw_comp"/>
    <sequenceFlow id="f11" sourceRef="b_ship_timer" targetRef="throw_comp"/>
    <sequenceFlow id="f12" sourceRef="b_notif_err" targetRef="throw_comp"/>
    <sequenceFlow id="f13" sourceRef="throw_comp" targetRef="end_compensated"/>
  </process>
</definitions>